// Your Niri config. This file is yours: darksaber copies it here once and
// never touches it again.
// https://yalter.github.io/niri/
// https://danklinux.com/docs/

// darksaber defaults (updated with the image)
include "/usr/share/darksaber/niri/darksaber.kdl"

// Generated by DankMaterialShell's settings (theme, binds, outputs, ...)
include optional=true "dms/alttab.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/wpblur.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/windowrules.kdl"
include optional=true "dms/input.kdl"

// Your own overrides
include optional=true "local.kdl"
